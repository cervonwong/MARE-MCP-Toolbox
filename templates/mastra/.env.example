# MARE-MCP-Toolbox bearer token. Get it from `./run_docker.sh --remote` ready-block,
# or `cat workspace/.mcp-gateway-token` from the repo root after the container starts.
MARE_GATEWAY_TOKEN=

# MCP gateway endpoint (Streamable HTTP). Default matches `./run_docker.sh --remote` defaults.
MARE_GATEWAY_URL=http://localhost:8080/mcp

# Model used by the Mastra Studio agent. Set the matching provider API key too,
# for example OPENAI_API_KEY when using the default below.
MARE_AGENT_MODEL=openai/gpt-4o-mini

# Optional Studio bind settings. Defaults match Mastra's local dashboard docs.
MARE_STUDIO_HOST=localhost
MARE_STUDIO_PORT=4111
