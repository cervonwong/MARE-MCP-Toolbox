# MARE-MCP-Toolbox remote-mode environment template.
# Copy to .env (`cp .env.example .env`) before `docker compose -f compose.yaml -f compose.remote.yaml up -d`.
# Every variable below is OPTIONAL except MCP_GATEWAY_ENABLED (required for remote mode).

# === Remote-mode toggle (REQUIRED for ./run_docker.sh --remote) ===
# Set to `1` to start the mcp-gateway daemon and expose Streamable HTTP on the host.
# This is the only un-commented var below so `cp .env.example .env` yields a working remote-mode env.
MCP_GATEWAY_ENABLED=1

# === Gateway network binding (OPTIONAL — sane defaults) ===
# In-container bind address for the gateway HTTP server.
# OPTIONAL — default: 127.0.0.1
# MCP_GATEWAY_HOST=127.0.0.1

# In-container port for the gateway HTTP server.
# OPTIONAL — default: 8080
# MCP_GATEWAY_PORT=8080

# Host-side bind address for the published port. Set to `0.0.0.0` to expose on the LAN.
# OPTIONAL — default: 127.0.0.1
# MCP_GATEWAY_HOST_BIND=127.0.0.1

# Host-side port mapped to the in-container gateway port.
# OPTIONAL — default: 8080
# MCP_GATEWAY_HOST_PORT=8080

# === Auth + uploads (OPTIONAL) ===
# Bearer token clients must present in `Authorization: Bearer <token>`.
# OPTIONAL — if blank, a random token is generated at gateway start and logged once.
# Pin this only when you need stable client config (e.g. .mcp.json checked into a repo).
# MCP_GATEWAY_TOKEN=

# Maximum upload size (in MiB) accepted by the gateway /upload endpoint.
# OPTIONAL — default: 1024
# MCP_GATEWAY_MAX_UPLOAD_MB=1024

# Suppress the one-line bearer-token log entry at gateway start (useful in CI).
# OPTIONAL — default: unset (token IS logged). Set to `1` to suppress.
# MCP_GATEWAY_QUIET=1

# === Dynamic Lab Mode (OPTIONAL — env-gated default-off) ===
# Set to `1` to register the Phase 11 dynamic-analysis tools (gdb sessions, strace/ltrace,
# qemu-user multi-arch, sandboxed-network probes). Also set by `./run_docker.sh --dynamic`.
# OPTIONAL — default: unset (dynamic tools NOT registered).
# MCP_GATEWAY_DYNAMIC_TOOLS=1

# === Image + workspace + license bind-mount paths (OPTIONAL) ===
# Docker image tag to pull / run.
# OPTIONAL — default: latest
# IMAGE_TAG=latest

# Host repo path bind-mounted to /workspace inside the container.
# OPTIONAL — default: . (the directory containing this .env)
# HOST_PWD=.

# Host directory bind-mounted to /home/agent/.binaryninja (license + EULA persistence).
# OPTIONAL — default: /tmp/.binaryninja-docker (ephemeral).
# For persistent BN licensing set to a stable host path, e.g. $HOME/.binaryninja-docker.
# BINARY_NINJA_USER_DIR=/tmp/.binaryninja-docker

# Host directory bind-mounted to /home/agent/.idapro (license + EULA + ida.reg persistence).
# OPTIONAL — default: /tmp/.idapro-docker (ephemeral).
# For persistent IDA licensing + one-time EULA acceptance set to a stable host path,
# e.g. $HOME/.idapro-docker.
# IDA_USER_DIR=/tmp/.idapro-docker

# Host directory bind-mounted to /home/agent/.claude (Claude Code state persistence).
# OPTIONAL — default: /tmp/.claude-docker (ephemeral).
# CLAUDE_USER_DIR=/tmp/.claude-docker

# Host directory bind-mounted to /home/agent/.codex (Codex CLI state persistence).
# OPTIONAL — default: /tmp/.codex-docker (ephemeral).
# CODEX_USER_DIR=/tmp/.codex-docker
